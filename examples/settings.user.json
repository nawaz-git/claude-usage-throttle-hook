{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/usage-throttle/statusline/quota_state.py",
    "refreshInterval": 10
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/usage-throttle/hooks/user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/usage-throttle/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/usage-throttle/hooks/session_start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/usage-throttle/hooks/stop.py"
          }
        ]
      }
    ]
  }
}
